generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordingContext {
  conversational
  formal
  interview
}

enum RecordingStatus {
  uploaded
  processing
  done
  failed
}

enum FeedbackValence {
  positive
  improve
}

// Mirrors auth.users (Supabase-managed). id must equal the auth.users.id
// of the corresponding account — created via a DB trigger or on first
// authenticated request, not by application code minting its own id.
model User {
  id                  String   @id @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  retentionPreference Int      @default(30) @map("retention_preference") // days raw audio is kept
  consentAcceptedAt   DateTime? @map("consent_accepted_at")

  recordings Recording[]

  @@map("users")
}

model Recording {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  // Nullable so the 30-day cleanup job can delete the stored media file and
  // null this out while keeping the transcript + metrics rows for progress.
  audioUrl      String?           @map("audio_url")
  hasVideo      Boolean           @default(false) @map("has_video")
  durationSec   Float             @map("duration_sec")
  context       RecordingContext
  status        RecordingStatus   @default(uploaded)
  audioExpiresAt DateTime?        @map("audio_expires_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript Transcript?
  metrics    Metrics?
  feedback   Feedback?

  @@index([userId, createdAt])
  @@map("recordings")
}

// words: [{ word: string, start: number, end: number, confidence?: number }]
model Transcript {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId String   @unique @map("recording_id") @db.Uuid
  fullText    String   @map("full_text")
  language    String?
  words       Json

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

// Audio-derived fields (wpm*, filler*, pause*, rushedFlag) are populated by
// the transcription + signal-analysis pipeline and are null until then.
// wpmWindowed: [{ start, end, wpm }]
// fillerEvents: [{ word, start, end }]
// pauseEvents: [{ start, end, duration, flag: 'awkward' | 'ok' }]
//
// Video-derived fields are populated at upload time, independent of
// transcription, since head-pose analysis doesn't need a transcript.
// cameraFacingPct: % of speech duration the speaker's head was oriented
//   toward the camera (a head-pose proxy, not true gaze/eye-tracking).
// gazeEvents: [{ start, end, facing: boolean }]
// smilePct: % of sampled frames the speaker was smiling (FaceLandmarker
//   blendshapes — a positive-affect proxy, not emotion classification).
// handsVisiblePct: % of sampled frames at least one hand was detected.
// gestureActivity: 0-1 score of hand movement between frames (0 = still,
//   1 = very animated). All three are computed on-device; video never leaves
//   the browser.
model Metrics {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId     String   @unique @map("recording_id") @db.Uuid
  wpmAvg          Float?   @map("wpm_avg")
  wpmWindowed     Json?    @map("wpm_windowed")
  fillerCount     Int?     @map("filler_count")
  fillerEvents    Json?    @map("filler_events")
  pauseEvents     Json?    @map("pause_events")
  rushedFlag      Boolean? @map("rushed_flag")
  cameraFacingPct Float?   @map("camera_facing_pct")
  gazeEvents      Json?    @map("gaze_events")
  smilePct        Float?   @map("smile_pct")
  handsVisiblePct Float?   @map("hands_visible_pct")
  gestureActivity Float?   @map("gesture_activity")

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@map("metrics")
}

// items: up to 2 entries — [{ metric, valence, message }]
model Feedback {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId String   @unique @map("recording_id") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at")
  items       Json

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@map("feedback")
}
