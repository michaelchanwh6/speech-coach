# Server-only. Used to call the Whisper transcription API.
OPENAI_API_KEY="sk-[...]"

# Vercel AI Gateway key — used to generate coaching feedback with a Claude
# model. On Vercel this is provided AUTOMATICALLY via OIDC (you don't need to
# set it in production). Only set it for local `next dev`. Get one from the
# AI Gateway tab in your Vercel dashboard.
AI_GATEWAY_API_KEY="[...]"

# Optional: override the feedback model (any AI Gateway slug). Defaults to
# anthropic/claude-sonnet-4.5.
# FEEDBACK_MODEL="anthropic/claude-sonnet-4.5"
