# From Supabase's "Connect to your project" dialog -> ORM tab.
# Pooled (transaction-mode, port 6543) - used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"
# Direct/session-mode (port 5432) - used only by the Prisma CLI for
# migrations (`npm run db:push`), since PgBouncer's transaction mode
# doesn't support the prepared statements schema changes need.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres"

# Supabase Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# "Publishable" key (sb_publishable_...) - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[...]"
# "Secret" key (sb_secret_...) - server-only, bypasses RLS. Never expose
# to the client or commit this.
SUPABASE_SECRET_KEY="sb_secret_[...]"

# Server-only. Used to call the Whisper transcription API.
OPENAI_API_KEY="sk-[...]"
