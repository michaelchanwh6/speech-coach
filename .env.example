# From Supabase's "Connect to your project" dialog -> ORM tab.
# Pooled (transaction-mode, port 6543) - used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"
# Direct/session-mode (port 5432) - used only by the Prisma CLI for
# migrations (`npm run db:push`), since PgBouncer's transaction mode
# doesn't support the prepared statements schema changes need.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres"

# Supabase Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# "Publishable" key (sb_publishable_...) - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[...]"

# Server-only. Used to call the Whisper transcription API.
OPENAI_API_KEY="sk-[...]"

# Vercel AI Gateway key — used to generate coaching feedback with a Claude
# model. On Vercel this is provided automatically via OIDC; set it locally for
# `next dev`. Get one from the AI Gateway tab in your Vercel dashboard.
AI_GATEWAY_API_KEY="[...]"
# Optional: override the feedback model (any AI Gateway slug). Defaults to
# anthropic/claude-sonnet-4.5. Bump to a newer Claude (e.g. a Claude 5 slug)
# here without touching code.
FEEDBACK_MODEL="anthropic/claude-sonnet-4.5"
